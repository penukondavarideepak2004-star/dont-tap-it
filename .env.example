# ==============================================================
# DON'T TAP IT! — Backend & Google Sheets Configuration
# ==============================================================

# Server Port
PORT=4000
NODE_ENV=development

# --------------------------------------------------------------
# Google Sheets Integration (Server-Side Only)
# --------------------------------------------------------------
# 1. Target Google Spreadsheet ID (from URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# 2. Sheet / Tab Name inside Spreadsheet (Default: Users)
GOOGLE_SHEETS_SHEET_NAME=Users

# 3. Google Cloud Service Account Email
GOOGLE_SERVICE_ACCOUNT_EMAIL=dont-tap-it-service-account@project-id.iam.gserviceaccount.com

# 4. Google Cloud Service Account RSA Private Key (PEM format with \n or actual line breaks)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"

# --------------------------------------------------------------
# Optional Production SMS Gateway (Twilio / Firebase / MSG91)
# --------------------------------------------------------------
# SMS_GATEWAY_API_KEY=your_sms_gateway_api_key
# SMS_SENDER_ID=DTTAP
